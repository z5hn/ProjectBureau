def season_events(month):
    try:
        month_number = int(month)
    except ValueError:
        print("Требуется ввести реальный номер месяца.")
        return

    if not 1 <= month_number <= 12:
        print("Введите номер месяца от 1 до 12.")
        return

    months = ["Январь", "Февраль", "Март",
              "Апрель", "Май", "Июнь",
              "Июль", "Август", "Сентябрь",
              "Октябрь", "Ноябрь", "Декабрь"]

    month_name = months[month_number - 1]

    events = {"Зима": "За окном падал белый снег.",
              "Весна": "Птицы пели прекрасные песни.",
              "Лето": "Солнце светило ярче чем было.",
              "Осень": "Урожай был невероятным."}

    seasons = {12: "Зима", 1: "Зима", 2: "Зима",
               3: "Весна", 4: "Весна", 5: "Весна",
               6: "Лето", 7: "Лето", 8: "Лето",
               9: "Осень", 10: "Осень", 11: "Осень"}

    season = seasons.get(month_number)
    event = events.get(season)

    message = f"Вы родились в {month_name}. {event}"
    print(message)

if __name__ == "__main__":
    user_input = input("Введите номер месяца рождения: ")
    season_events(user_input)
